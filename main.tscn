[sub_resource type="GDScript" id="GDScript_stkbm"]
script/source = "extends CharacterBody2D


const SPEED = 667.0
const JUMP_VELOCITY = -1200.0

@onready var sprite = $Sprite2D

var pine_count=0
var squish_tween: Tween

var ready_to_bounce = false
func _ready() -> void:
	var tween = create_tween().set_loops()
	tween.tween_property($Sprite2D, \"frame\", 1, 0.5)
	tween.tween_property($Sprite2D, \"frame\", 0, 0.5)
	


func _process(delta: float) -> void:
	print(Global.count)
	
func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	var direction := Input.get_axis(\"left\", \"right\")
	if direction:
		velocity.x = direction * SPEED
		sprite.flip_h=direction>0
		sprite.texture = preload(\"res://spritesheet (1).png\")
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		sprite.texture = preload(\"res://spritesheet.png\")

	
	if Input.is_action_just_pressed(\"bounce\") and is_on_floor():
		assert(is_on_floor())
		ready_to_bounce = true
		squish_tween=create_tween().set_parallel()
		squish_tween.tween_property($Sprite2D,\"scale\",Vector2(0.3,0.2),0.2)
		squish_tween.tween_property($Sprite2D,\"position\",Vector2(0,25),0.2)
		
	if Input.is_action_just_released(\"bounce\"):
		
		if squish_tween.is_running() or not is_on_floor() or not ready_to_bounce:
			var unsquish_tween=create_tween().set_parallel()
			unsquish_tween.tween_property($Sprite2D,\"scale\",Vector2(0.3,0.3), 0.1)
			unsquish_tween.tween_property($Sprite2D,\"position\",Vector2(0,0), 0.1)
		else:
			velocity.y=-2000
			$Sprite2D.scale=Vector2(0.3,0.3)
			$Sprite2D.position = Vector2.ZERO
		squish_tween.stop()
		squish_tween.kill()
		ready_to_bounce = false
	
	
	move_and_slide()
	


func _on_pinecone_body_entered(body: Node2D) -> void:
	pine_count=pine_count+1


func _on_area_2d_body_entered(body: Node2D) -> void:
	if body == self:
		$Camera2D.zoom = Vector2(0.3,0.3)
"

